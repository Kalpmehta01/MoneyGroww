# Copy this file to .env for local development with `netlify dev`
# (a plain `vite dev` won't run the serverless functions at all — see README).
#
# NEVER commit the real .env file. Keep API keys out of git and out of any
# client-side ("VITE_...") variable — anything prefixed VITE_ gets bundled
# into the public JS and would leak to every visitor's browser.

# Groq API key (https://console.groq.com) — used server-side only, by
# netlify/functions/chat.js. Get your own key from the Groq console; keys
# look like "gsk_...". This is NOT an xAI/"Grok" key — different provider,
# different key format (xAI keys start with "xai-").
GROQ_API_KEY=

# Optional: override the default model (llama-3.3-70b-versatile).
# GROQ_MODEL=llama-3.1-8b-instant
